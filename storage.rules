rules_version = '2';
// Firebase Storage 规则：允许已登录用户上传，允许所有人通过下载链接读取（用于 App 内展示头像/封面）
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    match /covers/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }
  }
}
