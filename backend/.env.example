# Firebase service account JSON path (relative to backend/ or absolute)
GOOGLE_APPLICATION_CREDENTIALS=../path/to/serviceAccountKey.json
# Or leave unset and set GOOGLE_APPLICATION_CREDENTIALS in your shell

# Optional: Gemini API key for AI generate/rewrite and daily content polish
GEMINI_API_KEY=your_gemini_api_key

# Optional: The Cat API key (free tier works without key; key raises rate limits)
THE_CAT_API_KEY=

# Port
PORT=8000
